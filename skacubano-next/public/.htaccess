# Configuración de Apache para la web de Ska Cubano (names.co.uk)
Options -Indexes
# Las páginas compiladas son ficheros .html junto a carpetas con el mismo nombre (admin.html y admin/):
# sin esto Apache redirigiría /admin a /admin/ antes de aplicar las reglas de abajo
DirectorySlash Off
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Carpeta de datos (JSON y config.php con la contraseña): nunca accesible desde fuera
  RewriteRule ^data(/|$) - [F,L]

  # API en PHP
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Enlaces privados: /privado/<slug> sirve siempre la misma página, que lee el slug de la URL
  RewriteRule ^privado/[^/]+/?$ privado.html [L]

  # URLs sin extensión: /galeria -> galeria.html, /admin/login -> admin/login.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Caché para imágenes, vídeos, fuentes y JS/CSS compilados (estos últimos llevan hash en el nombre)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  # Panel de admin, enlaces privados y sus ficheros (PDF, fotos): que ningún buscador los indexe
  <If "%{REQUEST_URI} =~ m#^/(admin|privado|uploads/privado)(/|\.html|$)#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  # JS/CSS compilados: llevan un hash en el nombre, así que se pueden guardar en caché un año.
  # (FilesMatch solo compara el nombre del fichero, no la carpeta: por eso se usa <If> con la URL)
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
